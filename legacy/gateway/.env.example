# =======================================
# Aperture AI Gateway — Environment Variables
# =======================================
# Copy this file to .env and fill in your values
# Deploy to Railway: add these in Railway > Variables tab

# -----------------------------------------------
# REQUIRED: OpenRouter API Key
# -----------------------------------------------
# Get your FREE key at https://openrouter.ai
# Gives access to GPT-4o, Claude 3.5, Gemini, Llama 3 and 300+ models
# Free models available: meta-llama/llama-3.1-8b-instruct:free, google/gemma-2-9b-it:free
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# -----------------------------------------------
# REQUIRED: PostgreSQL Database URL
# -----------------------------------------------
# Use your Supabase connection string:
# Supabase Dashboard → Project → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# -----------------------------------------------
# OPTIONAL
# -----------------------------------------------
# Port (Railway sets this automatically)
PORT=4000

# Your deployed app URL (used for OpenRouter request tracking)
APP_URL=https://your-aperture-app.netlify.app
