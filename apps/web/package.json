{
  "name": "@aperture/web",
  "version": "0.0.0",
  "private": true,
  "description": "Aperture dashboard and workspace (Next.js App Router)",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc -p tsconfig.json",
    "api:types": "openapi-typescript ../../docs/api/openapi.json --default-non-nullable false -o lib/api/schema.d.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aperture/core": "workspace:*",
    "better-auth": "^1.7.5",
    "next": "^16.3.5",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@aperture/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3"
  }
}
