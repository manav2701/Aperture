{
  "name": "aperture",
  "private": true,
  "description": "Governance control plane for AI spend",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "check:legacy-imports": "node tools/check-legacy-imports.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip && pnpm check:legacy-imports",
    "try:simulate": "pnpm --filter @aperture/cli simulate",
    "audit-verify": "pnpm --filter @aperture/cli audit-verify"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "knip": "^6.37.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
