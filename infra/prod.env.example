# Production environment for infra/compose.prod.yml (plan/phases/phase-10 §10.1).
# Copy to /srv/aperture/.env, fill in, and keep the real file encrypted with sops (age key in
# your password manager). Generate every secret fresh for production — never reuse staging's.
#   openssl rand -base64 32   → 32-byte keys (KEKs, secrets)

# --- Hosts --------------------------------------------------------------------------------
API_HOST=api.example.com
GATEWAY_HOST=gw.example.com
ACME_EMAIL=ops@example.com
WEB_ORIGIN=https://app.example.com
API_PUBLIC_URL=https://api.example.com
GATEWAY_PUBLIC_URL=https://gw.example.com
IMAGE_PREFIX=ghcr.io/<github-owner>
VERSION=v1.0.0
NODE_ENV=production
LOG_LEVEL=info

# --- Database (Postgres in compose; the app connects as the non-owner role) ----------------
POSTGRES_USER=aperture_owner
POSTGRES_PASSWORD=
POSTGRES_DB=aperture
DATABASE_MIGRATION_URL=postgres://aperture_owner:<password>@postgres:5432/aperture
DATABASE_URL=postgres://aperture_app:<app-password>@postgres:5432/aperture

# --- Backups (WAL-G to S3-compatible storage; Backblaze B2 / R2 / Supabase S3) --------------
WALG_S3_PREFIX=s3://aperture-backups/prod
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
AWS_REGION=eu-central-003
AWS_S3_FORCE_PATH_STYLE=true
# Client-side encryption of backups: 32 random bytes, hex or base64. Back it up offline (O6).
WALG_LIBSODIUM_KEY=

# --- Platform secrets ----------------------------------------------------------------------
BETTER_AUTH_SECRET=
APERTURE_KEY_PEPPER=
# Envelope encryption of connection secrets. Add APERTURE_KEK_V2 to rotate (docs/runbooks/rotate-kek.md).
APERTURE_KEK_V1=
ENFORCE_TWO_FACTOR=true

# --- Email ---------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=Aperture <noreply@example.com>

# --- Sign in with Google (optional) --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Media (images and video) --------------------------------------------------------------
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

# --- Slack app (optional: interactive approvals) -------------------------------------------
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- x402 signer (private network) ---------------------------------------------------------
SIGNER_SHARED_SECRET=
# Only the signer container needs this key; it is never given to the API or gateway.
SIGNER_KEK_V1=
SIGNER_RPC_DEVNET=https://devnet.helius-rpc.com/?api-key=<key>
SIGNER_RPC_MAINNET=https://mainnet.helius-rpc.com/?api-key=<key>
# Notary wallet for daily audit anchors (64-byte keypair as a JSON array).
NOTARY_SECRET_KEY=
# Only after the legal opinion (C1).
MAINNET_X402_ENABLED=false

# --- Aperture's own billing (Stripe Billing) -----------------------------------------------
STRIPE_BILLING_SECRET_KEY=
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BUSINESS=

# --- Observability -------------------------------------------------------------------------
# Bearer token for GET /metrics on every service (Prometheus format; scraped by Grafana Alloy).
METRICS_TOKEN=
